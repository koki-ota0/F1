{
  "name": "pitwall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PITWALL - the all-in-one F1 fan hub (live timing, standings, predictions, race sim, quiz, fan zone)",
  "scripts": {
    "dev": "vite",
    "bundle": "node scripts/sync-bundle.mjs",
    "prebuild": "node scripts/sync-bundle.mjs",
    "postbuild": "node scripts/postbuild.mjs",
    "qa:browser": "node scripts/browser-qa.mjs",
    "qa:build": "node scripts/secret-audit.mjs && vite build && node scripts/smoke.mjs && node scripts/interact5.mjs",
    "mock:openf1": "node scripts/mock-openf1.mjs 4180",
    "gen:2026": "node scripts/gen-2026-snapshot.mjs && npm run bundle",
    "build": "vite build",
    "start": "node server/index.js",
    "serve": "npm run build && node server/index.js",
    "qa:secrets": "node scripts/secret-audit.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^131.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^31.0.1",
    "playwright": "^1.49.1",
    "puppeteer-core": "^23.11.1",
    "vite": "^5.4.11"
  }
}
